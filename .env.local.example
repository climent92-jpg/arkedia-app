# Copia aquest fitxer com a .env.local i omple els valors del teu projecte
# de Supabase (Settings -> API a https://app.supabase.com).

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Obligatòria perquè el panell d'administració (/admin) funcioni: crear/
# editar/eliminar usuaris, professors i alumnes, i l'importador de CSV
# escriuen a Supabase amb aquesta clau. NOMÉS al servidor — mai l'exposis
# amb el prefix NEXT_PUBLIC_ ni la posis en codi de client.
SUPABASE_SERVICE_ROLE_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
